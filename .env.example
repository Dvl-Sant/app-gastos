PORT=3000
DB_HOST=db
DB_PORT=5432
DB_NAME=appgastos
DB_USER=postgres
DB_PASSWORD=postgres
JWT_SECRET=change_this_to_a_secure_random_string
# Orígenes permitidos para CORS (separados por comas). '*' = cualquiera (solo local)
CORS_ORIGIN=*
# Zona horaria del servidor (afecta "hoy" para liquidaciones, cortes y vencimientos)
TZ=America/Mexico_City
